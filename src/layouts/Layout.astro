---
const red = "#F38181";
const yellow = "#fff9e6";
const green = "#D6F7AD";
const blue = "#95E1D3";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Assistant:wght@200..800&family=Magra:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>Cindy's Page</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global define:vars={{ red, yellow, green, blue }}>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    font-family: "Assistant", serif;
  }
</style>

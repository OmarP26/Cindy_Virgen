---
import { Image } from "astro:assets";
import acercade from "../assets/icons/acercade.svg";
import servicios from "../assets/icons/servicios.svg";
import trabajos from "../assets/icons/trabajos.svg";
import contacto from "../assets/icons/contacto.svg";
import logo from "../assets/logo.png";
import { spring } from "motion";

// const paths = {
//   "Acerca de": "/",
//   Servicios: "/",
//   Trabajo: "/",
//   Contacto: "/",
// };

const paths = [
  {
    menu: "Acerca de",
    path: "/",
    icon: acercade,
  },
  {
    menu: "Servicios",
    path: "/",
    icon: servicios,
  },
  {
    menu: "Trabajos",
    path: "/",
    icon: trabajos,
  },
  {
    menu: "Contacto",
    path: "/",
    icon: contacto,
  },
];
---

<section id="navbar" class="flex p-4 bg-white items-center justify-between">
  <div class="w-[100px] h-full cursor-pointer">
    <a href="/">
      <Image src={logo} alt="Logo" class="" />
    </a>
  </div>
  <ul class="w-full gap-4 flex flex-row justify-end hidden sm:flex">
    {
      paths.map(({ menu, path, icon }) => (
        <li class="bounce p-3 border-0 rounded-full cursor-pointer group">
          <a href={`${path}`} class="group-hover:text-white flex flex-row">
            <Image src={icon} alt={menu} class="w-6 h-6 mr-1" />
            {menu}
          </a>
        </li>
      ))
    }
  </ul>
  <div
    id="burger-icon"
    class="p-3 cursor-pointer sm:hidden font-extrabold hover:border"
  >
    &#9776; <!-- Unicode character for burger icon -->
  </div>
</section>

<style define:vars={{ spring: spring(0.2, 0.8) }}>
  a {
    color: var(--red);
  }

  li {
    transition: transform var(--spring);
  }

  li:hover {
    background: var(--red);
    transition: scale(1.1);
  }

  #burger-icon {
    color: var(--red);
  }

  .bounce {
    transition: transform var(--spring);
  }
  .bounce:hover {
    transform: scale(1.1);
  }
</style>

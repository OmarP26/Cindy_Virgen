---
const paths = {
  Inicio: "/",
  "Seo y Seo Local": "seo",
  "Diseño y Desarrollo Web": "disenoweb",
  Branding: "branding",
};
---

<section id="navbar" class="flex p-4 border-b-2 bg-white">
  <div class="p-3">Logo</div>
  <ul class="w-full gap-4 flex flex-row justify-end hidden sm:flex">
    {
      Object.entries(paths).map(([name, path]) => (
        <li class="p-3 hover:border-b-2 hover:font-extrabold cursor-pointer">
          <a href={`${path}`} class="">
            {name}
          </a>
        </li>
      ))
    }
  </ul>
  <div
    id="burger-icon"
    class="p-3 cursor-pointer sm:hidden font-extrabold hover:border"
  >
    &#9776; <!-- Unicode character for burger icon -->
  </div>
</section>

<style>
  a {
    color: var(--red);
  }

  li:hover {
    border-color: var(--red);
  }

  #burger-icon {
    color: var(--red);
  }
</style>

<section id="contacto">
  <div class="container">
    <div class="subtitle">
      <h2>Vamos a conocernos! Mandame un mensaje...</h2>
    </div>
    <div class="form">
      <input type="text" placeholder="Nombre y Apellidos" />
      <input type="email" placeholder="Email" />
      <input type="tel" placeholder="Teléfono" />
      <button type="submit">Enviar</button>
    </div>
    <div class="conditions">
      <input type="checkbox" /> Acepto los <a href="">Términos y Condiciones</a>
    </div>
  </div>
</section>

<style>
  #contacto {
    display: flex;
    border: 1px solid black;
    width: 100%;
    padding: 3rem 0;
    justify-content: center;
    margin: 0 auto;
  }
</style>
